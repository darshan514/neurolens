# Copy to .env and fill in real values.
DATABASE_URL=postgresql+psycopg://neurolens:neurolens@localhost:5432/neurolens
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]

# Optional — LLM coach / doctor summaries (falls back to templates without these)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional — trained ML artifacts (see requirements-ml.txt)
NL_MODEL_DIR=models
NL_VOICE_ENCODER=facebook/wav2vec2-base

# Research anonymization pepper — keep secret, stable across restarts
NL_ANON_PEPPER=change-me-pepper
