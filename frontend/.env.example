[TEMPLATE]
# Base URL of the NeuroLens API. Empty = same-origin /api (Vite dev proxy).
VITE_API_URL=

# Google OAuth client ID (optional) — enables the "Continue with Google" button.
# Create one at https://console.cloud.google.com/apis/credentials (OAuth client, Web application).
# Authorized JS origins must include your site origin (e.g. http://localhost:5175, https://frontend-omega-neon-66.vercel.app).
VITE_GOOGLE_CLIENT_ID=
